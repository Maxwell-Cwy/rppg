<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white">

    <!-- 全屏摄像头预览（初始隐藏） -->
    <androidx.camera.view.PreviewView
        android:id="@+id/preview_view"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btn_exit_preview"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|start"
        android:layout_margin="16dp"
        android:text="返回"
        android:textColor="@android:color/white"
        app:backgroundTint="#80000000"
        android:paddingLeft="12dp"
        android:paddingRight="12dp"
        android:visibility="gone" />
    <!-- 倒计时显示（仅在预览时可见） -->
    <TextView
        android:id="@+id/tv_countdown"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|center_horizontal"
        android:layout_marginTop="16dp"
        android:background="#80000000"
        android:paddingLeft="16dp"
        android:paddingRight="16dp"
        android:paddingTop="8dp"
        android:paddingBottom="8dp"
        android:text="90"
        android:textColor="@android:color/white"
        android:textSize="24sp"
        android:textStyle="bold"
        android:visibility="gone" />

    <!-- 原始操作界面 -->
    <LinearLayout
        android:id="@+id/layout_control"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- 状态显示区（四分区） -->
        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:fillViewport="true">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="12dp">

                <!-- 1. 蓝牙状态区 -->
                <TextView
                    android:id="@+id/tv_bluetooth_status"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="请点击「蓝牙检测」按钮选择设备\n当前状态：蓝牙未连接"
                    android:textSize="16sp"
                    android:textColor="@android:color/black"
                    android:lineSpacingExtra="4dp"
                    android:background="#E3F2FD"
                    android:padding="12dp"
                    android:layout_marginBottom="8dp" />

                <!-- 2. 血压录入区 -->
                <TextView
                    android:id="@+id/tv_blood_pressure_status"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text=""
                    android:textSize="16sp"
                    android:textColor="@android:color/black"
                    android:lineSpacingExtra="4dp"
                    android:background="#F3E5F5"
                    android:padding="12dp"
                    android:layout_marginBottom="8dp"
                    android:visibility="gone" />

                <!-- 3. 本轮检测结果区 -->
                <TextView
                    android:id="@+id/tv_detection_result"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text=""
                    android:textSize="16sp"
                    android:textColor="@android:color/black"
                    android:lineSpacingExtra="4dp"
                    android:background="#F1F8E9"
                    android:padding="12dp"
                    android:layout_marginBottom="8dp"
                    android:visibility="gone" />

                <!-- 4. 上传与结束信息区 -->
                <TextView
                    android:id="@+id/tv_upload_and_end"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text=""
                    android:textSize="16sp"
                    android:textColor="@android:color/black"
                    android:lineSpacingExtra="4dp"
                    android:background="#FFF3E0"
                    android:padding="12dp"
                    android:layout_marginBottom="8dp"
                    android:visibility="gone" />

            </LinearLayout>

        </ScrollView>


        <!-- 按钮区 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_bluetooth_detect"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:text="1. 蓝牙检测（选择设备)"
                android:textSize="17sp"
                android:layout_marginBottom="12dp" />
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_start_detection"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:text="2. 开始检测（90秒）"
                android:textSize="17sp"
                android:enabled="false"
                android:alpha="0.5"
                android:layout_marginBottom="12dp" />
            <!-- 手动上传 + 输入血压（同行） -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:orientation="horizontal"
                android:layout_marginBottom="12dp">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_manual_upload"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:text="手动上传数据"
                    android:textSize="16sp"
                    android:enabled="false"
                    android:alpha="0.5"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_input_blood_pressure"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:text="输入血压"
                    android:textSize="16sp"
                    android:layout_marginStart="8dp"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton" />

            </LinearLayout>


<!--            <ProgressBar-->
<!--                android:id="@+id/progress_upload"-->
<!--                style="?android:attr/progressBarStyleHorizontal"-->
<!--                android:layout_width="match_parent"-->
<!--                android:layout_height="8dp"-->
<!--                android:max="100"-->
<!--                android:progress="0"-->
<!--                android:visibility="gone"-->
<!--                android:layout_marginTop="8dp" />-->
<!--            <TextView-->
<!--                android:id="@+id/tv_upload_progress"-->
<!--                android:layout_width="match_parent"-->
<!--                android:layout_height="wrap_content"-->
<!--                android:text=""-->
<!--                android:textSize="14sp"-->
<!--                android:gravity="center"-->
<!--                android:visibility="gone" />-->


        </LinearLayout>
    </LinearLayout>
    <!-- 上传中蒙层（全屏半透明遮罩） -->
    <!-- 上传中蒙层容器 -->
    <LinearLayout
        android:id="@+id/upload_overlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#80000000"
        android:clickable="true"
        android:focusable="true"
        android:visibility="gone"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="32dp">

        <TextView
            android:id="@+id/tv_uploading_hint"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="上传中，请稍候..."
            android:textColor="@android:color/white"
            android:textSize="18sp"
            android:layout_marginBottom="16dp" />

        <ProgressBar
            android:id="@+id/progress_upload"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="240dp"
            android:layout_height="8dp"
            android:max="100"
            android:progress="0"
            android:layout_marginBottom="8dp" />

        <TextView
            android:id="@+id/tv_upload_progress"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="0%"
            android:textColor="@android:color/white"
            android:textSize="14sp" />

    </LinearLayout>
</FrameLayout>